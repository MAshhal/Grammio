<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below. See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The API key is encrypted with an AndroidKeyStore key that never leaves the device, so a
         restored copy could not be decrypted. Keep it out of backups. -->
    <exclude domain="file" path="datastore/api_key.preferences_pb" />
</full-backup-content>
