<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 31+. See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The API key is encrypted with an AndroidKeyStore key that never leaves the device, so a
         restored or transferred copy could not be decrypted. Keep it out of both. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/api_key.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/api_key.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
